#!name=考试宝 接口诊断
#!desc=临时诊断插件：弹出考试宝接口的真实 URL，用完请删除
#!tag=诊断

[Script]
http-response ^https?://.* script-path=https://fastly.jsdelivr.net/gh/QAQ60/loon-plugins-public@master/scripts/ksb-debug.js, requires-body=false, timeout=10, tag=ksb-debug

[MITM]
hostname = %APPEND% *.kaoshibao.com, *.ankianki.com, *.yisouti.com, *.jxedt.com

# 用法：导入并启用 → 完全退出考试宝 App 再重新打开 → 进「我的」页面
# 命中时会弹通知，标题为「考试宝命中: 域名」，副标题是路径
# 把通知截图发我，即可定位真实接口；定位完成后请停用/删除本插件
