#!name=考试宝 kaoshibao
#!desc=考试宝 VIP/付费题库解锁。由 Yu9191 的 QX 重写转换，脚本自托管，并已补上 api.kaoshibao.com 新域名。
#!tag=考试宝

[Rewrite]
^https:\/\/(api\.ankianki\.com|api\.kaoshibao\.com)\/banner\/get$ - reject

[Script]
http-response ^https:\/\/(api\.ankianki\.com|api\.kaoshibao\.com|search-api\.yisouti\.com)\/(user\/userInfo\/get|search\/(getOcrStatus|ocr2|mixPaper)|kaoShi\/.*|paper\/(home|topErrors)|user\/coupon\/getExpireInfo|mockExam\/config|document\/file|questions\/fetch) script-path=https://fastly.jsdelivr.net/gh/QAQ60/loon-plugins-public@master/scripts/kaoshibao.js, requires-body=true, timeout=60, tag=kaoshibao

[MITM]
hostname = %APPEND% api.ankianki.com, api.kaoshibao.com, search-api.yisouti.com

# 说明:
# - api.ankianki.com 为旧域名，api.kaoshibao.com 为新域名，两者解析到同一后端
#   (43.144.202.140 / fe-jx-v4.op.jxedt.com)，同时保留可兼容新旧版本 App。
# - 若只想走新域名，把上面三条里的 api.ankianki.com 删掉即可。
# - 默认用 fastly.jsdelivr.net（国内连通性较好）；若仍下载失败，依次尝试：
#   https://gcore.jsdelivr.net/gh/QAQ60/loon-plugins-public@master/scripts/kaoshibao.js
#   https://cdn.jsdelivr.net/gh/QAQ60/loon-plugins-public@master/scripts/kaoshibao.js
#   https://ghfast.top/https://raw.githubusercontent.com/QAQ60/loon-plugins-public/master/scripts/kaoshibao.js
