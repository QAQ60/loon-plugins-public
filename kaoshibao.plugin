#!name=考试宝 kaoshibao
#!desc=考试宝 VIP/付费题库/搜题识图解锁（Loon 版，覆盖 ksbapi/gw-api/search-api/kaoshiapi/richmanrules）
#!tag=考试宝
#!author=QAQ60
#!homepage=https://github.com/QAQ60/loon-plugins-public

# ============================================================
#  重要：Loon 的「抓包」开关 = MITM 总开关
#  关闭抓包时，Loon 不走 MITM 解密，任何 http-response 脚本都不会
#  被触发（不是本插件的问题）。使用本插件必须保持抓包开启。
#  关闭抓包后若仍想改写，只能在 Shadowrocket 里用 .sgmodule。
# ============================================================

[General]
# 脚本需要响应体时由 Loon 自行缓冲，无需额外设置

[Rewrite]
# 首页横幅广告
^https?:\/\/(api\.ankianki\.com|api\.kaoshibao\.com|ksbapi\.jxedt\.com)\/banner\/get$ - reject

[Script]
# 主规则：一条覆盖全部考试宝/一点通接口，具体改写由脚本按 host+path 判断
http-response ^https?:\/\/(ksbapi|gw-api|search-api|userapi|kaoshiapi|legoapi|richmanrules)\.(jxedt|ksedt)\.com\/ script-path=https://fastly.jsdelivr.net/gh/QAQ60/loon-plugins-public@6f3a5f1a8da7576c07961213957e8aaa779119b9/scripts/kaoshibao.js?v=6f3a5f1a8da7576c07961213957e8aaa779119b9, requires-body=true, timeout=60, tag=kaoshibao

# 旧域名兼容
http-response ^https?:\/\/(api\.ankianki\.com|api\.kaoshibao\.com|search-api\.yisouti\.com)\/ script-path=https://fastly.jsdelivr.net/gh/QAQ60/loon-plugins-public@6f3a5f1a8da7576c07961213957e8aaa779119b9/scripts/kaoshibao.js?v=6f3a5f1a8da7576c07961213957e8aaa779119b9, requires-body=true, timeout=60, tag=kaoshibao-legacy

[MITM]
# 精确域名列表，避免过度解密影响性能
hostname = %APPEND% ksbapi.jxedt.com, gw-api.jxedt.com, search-api.ksedt.com, userapi.ksedt.com, kaoshiapi.ksedt.com, legoapi.ksedt.com, richmanrules.ksedt.com, api.ankianki.com, api.kaoshibao.com, search-api.yisouti.com

# ------------------------------------------------------------
# 说明
# 1. 若官方加新域名，可把 hostname 换成通配：
#      hostname = %APPEND% *.jxedt.com, *.ksedt.com, *.ankianki.com, *.kaoshibao.com, *.yisouti.com
#    并把 Script 规则的 (jxedt|ksedt)\.com 改成对应通配，代价是解密流量变大。
# 2. 脚本地址固定到 6f3a5f1a8da7576c07961213957e8aaa779119b9，升级脚本时需同步替换本文件里的 SHA。
# 3. 排障：把 scripts/kaoshibao.js 顶部的 DEBUG 改成 true，会弹通知显示每次改写结果。
# ------------------------------------------------------------
